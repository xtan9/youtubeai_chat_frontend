# Environment Configuration Example
# Copy this file to .env.local and update with your values

# Environment
NODE_ENV=development

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here
# Keep this stable when switching Supabase API hostnames (for example, to
# https://auth.youtubeai.chat) so existing browser sessions survive rollout
# and rollback. Override it when using a different Supabase project.
NEXT_PUBLIC_SUPABASE_AUTH_COOKIE_NAME=sb-fzfgyeltcvnwmluqlwhn-auth-token

# VPS Transcription Service (Whisper fallback)
VPS_API_URL=https://your-vps-domain.com
VPS_API_KEY=your-vps-api-key
# Optional one-deploy overlap key. Set the new service key as VPS_API_KEY,
# keep the previous value here while both deployments roll, then remove it.
VPS_API_KEY_PREVIOUS=
VPS_TIMEOUT_MS=240000
VPS_METADATA_TIMEOUT_MS=30000
VPS_CAPTIONS_TIMEOUT_MS=30000

# LLM Gateway
LLM_GATEWAY_URL=https://your-vps-domain.com/v1
LLM_GATEWAY_API_KEY=your-llm-gateway-api-key
LLM_MODEL=gpt-5.3-codex-spark

# Optional Project cost rate card. Cost is explicitly unavailable unless all
# fields are set from the actual configured gateway/provider contract.
PROJECT_MODEL_RATE_CARD_VERSION=
PROJECT_MODEL_RATE_CARD_SOURCE=
PROJECT_MODEL_RATE_CARD_MODEL_ID=
PROJECT_MODEL_RATE_CARD_GATEWAY_PROVIDER=
PROJECT_MODEL_RATE_CARD_EFFECTIVE_DATE=
PROJECT_MODEL_INPUT_USD_PER_MILLION_TOKENS=
PROJECT_MODEL_CACHED_INPUT_USD_PER_MILLION_TOKENS=
PROJECT_MODEL_OUTPUT_USD_PER_MILLION_TOKENS=

# Supabase secret API key (server-side only; variable name retained for compatibility)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key-here

# Catalog Admission (server-side only)
YOUTUBE_DATA_API_KEY=
# Vercel Cron sends this value as the Bearer token to scheduled routes.
CRON_SECRET=

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only PostHog query access for the Admin Subscription funnel.
# Create a read-only personal API key and use the numeric PostHog project ID.
POSTHOG_QUERY_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=your_posthog_project_id_here
POSTHOG_PERSONAL_API_KEY=your_posthog_personal_api_key_here
# Operator-approved Project GA review guardrails. Blank values keep the
# machine-readable readiness decision at controlled_beta.
PROJECT_READINESS_MAX_PROCESSING_FAILURE_PCT=
PROJECT_READINESS_MAX_COST_PER_ACTIVATED_PROJECT_USD_MICROS=
# Random 16+ character server-only secret used by Vercel Cron authorization.
CRON_SECRET=
# Exact UTC instant when the direct Subscription rollout begins. The report
# compares 7d/14d post-release windows with equal immediately preceding windows.
SUBSCRIPTION_FUNNEL_RELEASE_AT=2026-08-10T12:00:00.000Z

# Stripe (paywall — phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HMAC signing key for the anonymous lifetime-summary cookie (32+ random chars)
ANON_COOKIE_SECRET=

# Anonymous Trial passive controls (server-side only). The feature remains
# fail-closed unless the rollout flag is enabled, this kill switch is exactly
# false, and every required control below is configured. Use a stable random
# HMAC secret of at least 32 characters; never expose it to the browser.
ANONYMOUS_TRIAL_ENABLED=false
ANONYMOUS_TRIAL_KILL_SWITCH=true
# Vercel overwrites this adapter's provenance headers. Leave unset elsewhere.
ANONYMOUS_TRIAL_TRUSTED_IP_ADAPTER=vercel
ANONYMOUS_TRIAL_NETWORK_HMAC_SECRET=
ANONYMOUS_TRIAL_GLOBAL_24H_SPEND_LIMIT_MICROS=
ANONYMOUS_TRIAL_RESERVATION_COST_MICROS=
