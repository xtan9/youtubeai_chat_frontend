# Environment Configuration Example
# Copy this file to .env.local and update with your values

# Environment
NODE_ENV=development

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# VPS Transcription Service (Whisper fallback)
VPS_API_URL=https://your-vps-domain.com
VPS_API_KEY=your-vps-api-key
VPS_TIMEOUT_MS=240000

# LLM Gateway
LLM_GATEWAY_URL=https://your-vps-domain.com/v1
LLM_GATEWAY_API_KEY=your-llm-gateway-api-key
LLM_MODEL=claude-sonnet-4-6

# Supabase secret API key (server-side only; variable name retained for compatibility)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key-here

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Stripe (paywall — phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HMAC signing key for the anonymous lifetime-summary cookie (32+ random chars)
ANON_COOKIE_SECRET=
